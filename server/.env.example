PORT=5000

# OAuth para habilitar el botón "Continuar con Google" en la web
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Groq AI (Motor Principal Ultra-Rápido: Llama 3.3 70B Versatile)
# Obtén tu clave gratuita en: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API (Alternativa para chat y rutinas)
# Obtén gratis en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API (GPT-4o para chat, DALL-E 3 para generación de avatares)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# ElevenLabs API (Síntesis de voz realista)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Replicate API (Alternativa para generación de retratos hiperrealistas o cubistas)
REPLICATE_API_TOKEN=your_replicate_api_token_here

{
  "name": "emobi-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Emobi AI Companion Backend Server with Express and Babel",
  "main": "src/app.js",
  "scripts": {
    "dev": "nodemon --exec babel-node src/app.js",
    "start": "babel-node src/app.js",
    "build": "babel src -d dist",
    "serve": "node dist/app.js"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "msedge-tts": "^2.1.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.26.4",
    "@babel/core": "^7.26.7",
    "@babel/node": "^7.26.0",
    "@babel/preset-env": "^7.26.7",
    "nodemon": "^3.1.9"
  }
}
